# --- Chain / Wallet ---
EVM_RPC_URL=                     # GOAT Network testnet RPC endpoint
AGENT_PRIVATE_KEY=               # Wallet private key for the agent's EvmWalletProvider (testnet only, never mainnet key)
CHAIN_ID=                        # GOAT Network testnet chain ID

# --- ERC-8004 Identity Registry ---
ERC8004_IDENTITY_REGISTRY_ADDR=  # Testnet contract address (confirm with GOAT devrel)
ERC8004_REPUTATION_REGISTRY_ADDR=

# --- x402 Payments ---
X402_FACILITATOR_URL=            # x402 facilitator endpoint for GOAT Network testnet
X402_PAY_TO_ADDRESS=             # Address that receives micropayments for ShieldGuard's services
X402_NETWORK=eip155:48816        # CAIP-2 network id the facilitator settles on (48816 = GOAT Testnet3)
X402_PRICE_RISK_CHECK=$0.001     # x402 price string, e.g. "$0.001"
X402_PRICE_TRUST_CHECK=$0.001

# --- Data sources ---
CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements/gp.php
TLE_CACHE_TTL_SECONDS=3600

# --- Database ---
DATABASE_URL=postgres://user:password@localhost:5432/shieldguard   # hosted: append ?sslmode=require and use a pooler endpoint
PGPOOL_MAX=3                       # per-instance pg pool size — serverless instances multiply this

# --- Server ---
PORT=8787                          # local node server only; Vercel assigns its own

# --- Deployment (Vercel) ---
# The same app serves two ways:
#   local:  npx tsx src/index.ts      (long-running node server)
#   vercel: api/index.ts function     (rewrites /v1/* and /health → /api/index)
# Required Vercel project env vars: DATABASE_URL, X402_FACILITATOR_URL,
# X402_PAY_TO_ADDRESS, X402_PRICE_RISK_CHECK, X402_PRICE_TRUST_CHECK,
# X402_NETWORK (+ trust/registry vars for /v1/trust-check).
